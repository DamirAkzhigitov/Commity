# Copy to `apps/api/.env` for local runs. Never commit real secrets.

# Postgres: default matches root docker-compose (localhost resolves to 127.0.0.1). For Supabase, use your project's connection URI instead.
DATABASE_URL=postgresql://pa:pa@localhost:5432/personal_assistant

# Supabase Auth — required for JWT verification on protected routes
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Access tokens for signed-in users typically use audience "authenticated" (comma-separated list supported).
# Verification supports RS256 and ES256 (Supabase asymmetric signing keys).
SUPABASE_JWT_AUD=authenticated

API_PORT=3000

# Optional: omit to use mock assistant responses (usage still persisted with model=mock)
# OPENAI_API_KEY=

# Optional USD per 1M tokens for estimated cost on usage rows (OpenAI path only)
# OPENAI_INPUT_USD_PER_MILLION=0.15
# OPENAI_OUTPUT_USD_PER_MILLION=0.6

# RevenueCat webhooks — POST /billing/webhooks/revenuecat (requires Nest rawBody + signature header)
# Dashboard webhook secret; verifies X-RevenueCat-Signature (HMAC-SHA256 body, base64 digest).
# REVENUECAT_WEBHOOK_SECRET=
# Optional: exact Authorization header value RevenueCat sends if configured in dashboard (timing-safe compare).
# REVENUECAT_WEBHOOK_AUTHORIZATION=

# Dev-only admin endpoints (disabled in production). Required to use /dev-admin/users/* routes.
# DEV_ADMIN_SECRET=
