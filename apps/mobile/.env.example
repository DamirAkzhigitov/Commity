# Expo loads `.env` from this package root. Use EXPO_PUBLIC_* so variables are available in the app.
#
# Supabase on mobile is **Auth-only** (session + JWT). Do not use PostgREST/Realtime/Storage from the app.
# Keep **Data API OFF** in Supabase Dashboard — see docs/SUPABASE_SETUP.md.
#
# EXPO_PUBLIC_SUPABASE_URL must match apps/api/.env `SUPABASE_URL` (same project) or the API returns 401 on /assistant/chat.
#
# API base (Nest) for /assistant/chat — must be reachable from the device.
# - Android emulator: http://10.0.2.2:3000 (or http://localhost:3000 — remapped automatically when not a physical device).
# - Physical Android phone: use your computer's LAN IP, e.g. http://192.168.1.10:3000 (not localhost).
# - iOS simulator: http://localhost:3000 usually works.
# Dev HTTP needs a rebuild after pulling app.json changes: `android.usesCleartextTraffic` is enabled for http:// APIs.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
