DATABASE_URL="postgresql://postgres:postgres@localhost:5432/personal_assistant"
OPENAI_API_KEY="sk-change-me"
JWT_ISSUER="personal-assistant-dev"
GOOGLE_PLAY_PACKAGE_NAME="com.personalassistant.app"
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""
API_PORT="3000"

# Mobile (Expo): copy to apps/mobile/.env — only EXPO_PUBLIC_* are bundled.
# **Auth-only**: Supabase is used for sign-in/session JWTs only, not for PostgREST/data APIs.
# **Data API** must stay OFF in Supabase project settings (see docs/SUPABASE_SETUP.md).
# **CRITICAL**: EXPO_PUBLIC_SUPABASE_URL must be the SAME Supabase project as apps/api/.env `SUPABASE_URL`
# or assistant/chat calls will return 401 (JWT issuer and JWKS must match).
# Android emulator → API host is usually http://10.0.2.2:3000 (not localhost).
# EXPO_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# EXPO_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# EXPO_PUBLIC_API_BASE_URL="http://10.0.2.2:3000"
